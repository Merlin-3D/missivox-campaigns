# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
# Public URL of the app: used in the tracking, unsubscribe and
# "view online" links of the emails. Must be reachable by your recipients.
APP_URL=http://${HOST}:${PORT}
VITE_APP_NAME=Missivox

# SQLite database file, relative to the project folder
DB_FILE=tmp/db.sqlite3

# Session
SESSION_DRIVER=cookie

# Mail (SMTP). In development, "docker compose up -d" starts Mailpit:
# every email is caught and visible on http://localhost:8025
MAIL_MAILER=smtp
MAIL_FROM_NAME=Missivox
MAIL_FROM_ADDRESS=no-reply@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=

# Lets workspaces without their own SMTP server send through the server
# above. Keep false when anyone can sign up: strangers would otherwise send
# from your SMTP account. Each workspace sets its server in its settings.
SMTP_SHARED=false

# Send queued emails from the web server process. Set to false and run
# "node ace campaigns:work" to send from a dedicated process instead.
CAMPAIGN_WORKER=true
